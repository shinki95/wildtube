{"songs": [{"id": "brahms-op118-2", "no": 1, "title": "브람스 인터메초 작품 118의 2번", "short": "브람스 Op.118-2", "A": "페라이어", "B": "굴드", "cA": "listen/app/img/yt_brahms-op118-2_A_sq.jpg", "cB": "listen/app/img/yt_brahms-op118-2_B_sq.jpg", "n": 7, "line": "만년의 페라이어는 따뜻하게 노래하고, 젊은 굴드는 속삭이듯 안으로 파고들어요.", "comp": "brahms", "compName": "브람스"}, {"id": "chopin-nocturne-20", "no": 2, "title": "쇼팽 녹턴 20번 올림다단조 (유작)", "short": "쇼팽 녹턴 20번", "A": "조성진", "B": "임윤찬", "cA": "listen/app/img/yt_chopin-nocturne-20_A_sq.jpg", "cB": "listen/app/img/yt_chopin-nocturne-20_B_sq.jpg", "n": 4, "line": "조성진은 은빛 소리로 담담하게 흘려보내고, 임윤찬은 무언가 시작되기 직전마다 숨을 참으며 머물러요.", "comp": "chopin", "compName": "쇼팽"}, {"id": "chopin-nocturne-op9-2", "no": 3, "title": "쇼팽 녹턴 내림마장조 작품 9의 2", "short": "쇼팽 녹턴 9-2", "A": "루빈스타인", "B": "피레스", "cA": "listen/app/img/yt_chopin-nocturne-op9-2_A_sq.jpg", "cB": "listen/app/img/yt_chopin-nocturne-op9-2_B_sq.jpg", "n": 5, "line": "루빈스타인은 돌아오는 노래마다 소리를 키우며 당당하게 노래하고, 피레스는 끝까지 여리게 속삭이다 마지막에 오래 머물러요.", "comp": "chopin", "compName": "쇼팽"}, {"id": "chopin-prelude-15", "no": 4, "title": "쇼팽 전주곡 작품 28의 15 ‘빗방울’", "short": "쇼팽 빗방울 전주곡", "A": "조성진", "B": "폴리니", "cA": "listen/app/img/yt_chopin-prelude-15_A_sq.jpg", "cB": "listen/app/img/yt_chopin-prelude-15_B_sq.jpg", "n": 6, "line": "콩쿠르 무대의 조성진은 시간을 넓혀 정점의 무게를 만들고, 폴리니는 걸음을 지킨 채 소리의 크기로 키워요.", "comp": "chopin", "compName": "쇼팽"}, {"id": "debussy-clair-de-lune", "no": 5, "title": "드뷔시 베르가마스크 모음곡 3곡 「달빛」", "short": "드뷔시 달빛", "A": "기제킹", "B": "조성진", "cA": "listen/app/img/yt_debussy-clair-de-lune_A_sq.jpg", "cB": "listen/app/img/yt_debussy-clair-de-lune_B_sq.jpg", "n": 6, "line": "기제킹은 소리를 부드럽게 번지게 두고, 조성진은 맑게 세운 소리로 새 부분 앞마다 숨을 길게 쉬어요.", "comp": "debussy", "compName": "드뷔시"}, {"id": "schumann-traumerei", "no": 6, "title": "슈만 어린이 정경 7번 트로이메라이", "short": "슈만 트로이메라이", "A": "호로비츠", "B": "아르헤리치", "cA": "listen/app/img/yt_schumann-traumerei_A_sq.jpg", "cB": "listen/app/img/yt_schumann-traumerei_B_sq.jpg", "n": 6, "line": "말년의 호로비츠는 담백하게 흘려보내고, 아르헤리치는 같은 선율을 두 번째에 더 여리고 다정하게 다시 불러요.", "comp": "schumann", "compName": "슈만"}, {"id": "schubert-d899-3", "no": 7, "title": "슈베르트 즉흥곡 내림사장조 D.899-3", "short": "슈베르트 즉흥곡 D.899-3", "A": "루푸", "B": "우치다", "cA": "listen/app/img/yt_schubert-d899-3_A_sq.jpg", "cB": "listen/app/img/yt_schubert-d899-3_B_sq.jpg", "n": 6, "line": "루푸는 한결같은 느린 걸음으로 노래를 띄우고, 우치다는 세게 몰아가다 여린 곳에서 멈춰 서며 대비를 그려요.", "comp": "schubert", "compName": "슈베르트"}, {"id": "bach-goldberg-aria", "no": 8, "title": "바흐 골드베르크 변주곡 BWV 988: 아리아", "short": "골드베르크 아리아", "A": "굴드 1955", "B": "굴드 1981", "cA": "listen/app/img/yt_bach-goldberg-aria_A_sq.jpg", "cB": "listen/app/img/yt_bach-goldberg-aria_B_sq.jpg", "n": 5, "line": "스물두 살 굴드는 춤추듯 가볍게 지나가고, 마흔여덟 살 굴드는 음 하나하나를 공중에 걸어 두듯 머물러요.", "comp": "bach", "compName": "바흐"}], "composers": [{"key": "brahms", "name": "브람스", "img": "listen/app/img/p_brahms.jpg"}, {"key": "chopin", "name": "쇼팽", "img": "listen/app/img/p_chopin.jpg"}, {"key": "debussy", "name": "드뷔시", "img": "listen/app/img/p_debussy.jpg"}, {"key": "schumann", "name": "슈만", "img": "listen/app/img/p_schumann.jpg"}, {"key": "schubert", "name": "슈베르트", "img": "listen/app/img/p_schubert.jpg"}, {"key": "bach", "name": "바흐", "img": "listen/app/img/p_bach.jpg"}]}